# Dockerfile de desenvolvimento do Frontend React (com Vite dev server + hot-reload)
FROM node:22-alpine
WORKDIR /app

# Copia manifesto e instala dependências antes de copiar o código
# (aproveitando cache de layers do Docker)
COPY package.json package-lock.json ./
RUN npm install

# Copia o restante do código
COPY . .

EXPOSE 5173

# Sobe o servidor de desenvolvimento com host 0.0.0.0 para ser acessível fora do container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
